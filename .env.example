# AbuseIPDB: informe uma ou mais chaves separadas por vírgula.
ABUSEIPDB_API_KEYS=

# VirusTotal: chave única.
VIRUSTOTAL_API_KEY=

# Pulsedive: opcional. Conta gratuita em pulsedive.com eleva a cota diária da API;
# sem chave a API aceita poucas requisições por dia.
PULSEDIVE_API_KEY=

# Opcional: conecte a um Chrome já aberto com depuração remota em vez de
# abrir o Chromium gerenciado pelo Playwright. No Docker use host.docker.internal.
# CHROME_DEBUG_URL=http://127.0.0.1:9222/json

# 1 = janela invisível (recomendado em servidor/CI); 0 = janela visível.
FIBRABOTS_HEADLESS=0

# Opções de execução (segundos)
FIBRABOTS_REQUEST_TIMEOUT=30
FIBRABOTS_REQUEST_DELAY=0
FIBRABOTS_BROWSER_TIMEOUT=120
FIBRABOTS_BROWSER_PAUSE=5

# Caminhos opcionais (relativos à raiz do projeto ou absolutos)
# FIBRABOTS_HOME=
# FIBRABOTS_DATA_DIR=data
# FIBRABOTS_INPUT_DIR=data/input
# FIBRABOTS_RAW_DIR=data/raw
# FIBRABOTS_PROCESSED_DIR=data/processed
