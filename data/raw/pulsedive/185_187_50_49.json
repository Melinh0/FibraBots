            "og:site_name": "\u062a\u0648\u0631 \u062e\u0627\u0631\u062c\u06cc \u0648 \u062f\u0627\u062e\u0644\u06cc - \u0647\u062a\u0644 \u0648 \u062a\u0648\u0631 \u0647\u0627\u06cc \u06af\u0631\u062f\u0634\u06af\u0631\u06cc - \u0622\u0648\u0627\u0646 \u06af\u0634\u062a",
            "og:url": "https:\/\/avangasht.com\/",
            "++title": "\u062a\u0648\u0631 \u062e\u0627\u0631\u062c\u06cc \u0648 \u062f\u0627\u062e\u0644\u06cc - \u0647\u062a\u0644 \u0648 \u062a\u0648\u0631 \u0647\u0627\u06cc \u06af\u0631\u062f\u0634\u06af\u0631\u06cc - \u0622\u0648\u0627\u0646 \u06af\u0634\u062a",
            "description": "\u0622\u0648\u0627\u0646 \u06af\u0634\u062a \u0645\u0631\u062c\u0639 \u0645\u0639\u062a\u0628\u0631 \u062e\u0631\u06cc\u062f \u062a\u0648\u0631\u0647\u0627\u06cc \u0644\u062d\u0638\u0647 \u0622\u062e\u0631\u06cc \u060c \u062a\u0648\u0631 \u0647\u0627\u06cc \u062f\u0627\u062e\u0644\u06cc \u0648 \u062e\u0627\u0631\u062c\u06cc \u060c \u062e\u0631\u06cc\u062f \u062a\u0648\u0631 \u0645\u0633\u0627\u0641\u0631\u062a\u06cc \u0647\u0648\u0627\u06cc\u06cc \u0648 \u0632\u0645\u06cc\u0646\u06cc \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc 24 \u0633\u0627\u0639\u062a\u0647 \u0628\u0631\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0628\u0647\u062a\u0631\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0633\u0641\u0631 \u060c \u0647\u0645\u0631\u0627\u0647 \u0634\u0645\u0627\u0633\u062a.",
            "og:title": "\u062a\u0648\u0631 \u062e\u0627\u0631\u062c\u06cc \u0648 \u062f\u0627\u062e\u0644\u06cc - \u0647\u062a\u0644 \u0648 \u062a\u0648\u0631 \u0647\u0627\u06cc \u06af\u0631\u062f\u0634\u06af\u0631\u06cc - \u0622\u0648\u0627\u0646 \u06af\u0634\u062a",
            "og:description": "\u0622\u0648\u0627\u0646 \u06af\u0634\u062a \u0645\u0631\u062c\u0639 \u0645\u0639\u062a\u0628\u0631 \u062e\u0631\u06cc\u062f \u062a\u0648\u0631\u0647\u0627\u06cc \u0644\u062d\u0638\u0647 \u0622\u062e\u0631\u06cc \u060c \u062a\u0648\u0631 \u0647\u0627\u06cc \u062f\u0627\u062e\u0644\u06cc \u0648 \u062e\u0627\u0631\u062c\u06cc \u060c \u062e\u0631\u06cc\u062f \u062a\u0648\u0631 \u0645\u0633\u0627\u0641\u0631\u062a\u06cc \u0647\u0648\u0627\u06cc\u06cc \u0648 \u0632\u0645\u06cc\u0646\u06cc \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc 24 \u0633\u0627\u0639\u062a\u0647 \u0628\u0631\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0628\u0647\u062a\u0631\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0633\u0641\u0631 \u060c \u0647\u0645\u0631\u0627\u0647 \u0634\u0645\u0627\u0633\u062a.",
            "keywords": "\u0622\u0698\u0627\u0646\u0633 \u0647\u0648\u0627\u067e\u06cc\u0645\u0627\u06cc\u06cc,\u062a\u0648\u0631\u0647\u0627\u06cc \u0644\u062d\u0638\u0647 \u0622\u062e\u0631\u06cc,\u062a\u0648\u0631 \u0627\u0631\u0632\u0627\u0646,\u062e\u0631\u06cc\u062f \u062a\u0648\u0631 \u0645\u0633\u0627\u0641\u0631\u062a\u06cc,\u062a\u0648\u0631 \u0647\u0648\u0627\u06cc\u06cc,\u062a\u0648\u0631 \u0632\u0645\u06cc\u0646\u06cc,\u0622\u0698\u0627\u0646\u0633 \u0645\u0633\u0627\u0641\u0631\u062a\u06cc \u0627\u0635\u0641\u0647\u0627\u0646,\u0633\u0627\u06cc\u062a \u062a\u0648\u0631,\u0622\u0698\u0627\u0646\u0633 \u0645\u0633\u0627\u0641\u0631\u062a\u06cc,\u062a\u0648\u0631,\u0622\u0698\u0627\u0646\u0633 \u0622\u0648\u0627\u0646 \u06af\u0634\u062a \u0627\u06cc\u0631\u0627\u0646\u06cc\u0627\u0646"
